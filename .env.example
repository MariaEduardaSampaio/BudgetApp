# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings → API Keys). Veja docs/supabase.md.
#
# A chave publishable/anon é pública por natureza (vai para o navegador);
# quem protege os dados é a Row Level Security do banco.
# NUNCA coloque aqui a chave secret/service_role.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
