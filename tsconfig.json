{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // O TypeScript 6 não inclui mais os tipos globais sozinho: Jest (testes) e Node (process.env).
    "types": ["jest", "node"],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
